# Mattermost bot credentials
# Create a bot account in System Console > Integrations > Bot Accounts
MATTERMOST_BASE_URL=https://chat.aisociety.se
MATTERMOST_BOT_TOKEN=

# Mastra storage (channels require persistent storage for thread state)
DATABASE_URL=file:./mastra.db

# Model providers (OpenRouter is the default; see agent's `model` field)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Alternative providers if you switch the agent model string:
# GOOGLE_GENERATIVE_AI_API_KEY=
# OPENAI_API_KEY=
# VERCEL_AI_GATEWAY_KEY=

# GitHub access for the official GitHub MCP server (read-only org scanning).
# Create a fine-grained PAT at https://github.com/settings/personal-access-tokens/new
# with resource owner = uuaisociety and "Public repositories (read-only)" access.
# The token is also accepted by the remote server at https://api.githubcopilot.com/mcp/.
GITHUB_TOKEN=
GITHUB_ORG=uuaisociety

# UUAIS website data — read-only MCP server hosted by the website at /api/mcp.
# Use the SAME secret as the website project's MCP_ADMIN_TOKEN.
# The agent holds NO Firebase credentials; all site data comes through this MCP server.
MCP_ADMIN_TOKEN=
MCP_URL=https://www.uuais.com/api/mcp

# Per-user rate limiting (abuse guard). Defaults are generous so regular
# members never hit them; a script or runaway loop gets cut off.
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=300

# UUAIS Business Hub (CRM) — read/write MCP server hosted by the Business Hub
# at /api/mcp. Use the SAME secret as the Business Hub project's MCP_API_TOKEN.
# Whether write tools are offered is decided by the Business Hub's
# MCP_ALLOW_WRITES, not by the agent.
CRM_MCP_TOKEN=
CRM_MCP_URL=https://uuaibiz.vercel.app/api/mcp

# Shared UUAIS Google Calendar. The service account holds no IAM roles; its
# only access is whatever the calendar's sharing settings grant it, and the
# agent requests the narrow calendar.events scope (no ACL, no calendar list).
# Calendar ID: Google Calendar > Settings and sharing > Integrate calendar.
GOOGLE_CALENDAR_ID=
# Either point at the key file...
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# ...or supply the two fields inline (better for Docker/systemd deploys).
# Keep the literal \n escapes in the private key.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
